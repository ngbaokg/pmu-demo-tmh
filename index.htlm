<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Quản Lý Phun Xăm Thẩm Mỹ - PMU Pro</title>

  <link rel="manifest" href="manifest.json">
  <meta name="theme-color" content="#1c1e24">
  <link rel="icon" href="icon-192.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="PMU Pro">
  <link rel="apple-touch-icon" href="icon-192.png">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/localforage/1.10.0/localforage.min.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.13.2/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.13.2/firebase-auth-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/10.13.2/firebase-firestore-compat.js"></script>
  <script src="https://accounts.google.com/gsi/client" async defer></script>
  <style>
    :root {
      --primary-gold: #c5a059;
      --primary-gold-dark: #9e7d3b;
      --gold-gradient: linear-gradient(135deg, #d4af37 0%, #c5a059 50%, #9e7d3b 100%);
      --bg-dark: #121316;
      --bg-card: #1c1e24;
      --bg-input: #252830;
      --text-main: #f0f2f5;
      --text-muted: #9ba1a6;
      --border-color: #2f3440;
      --success: #2ecc71;
      --danger: #e74c3c;
      --warning: #f39c12;
      --zalo-blue: #0068ff;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; -webkit-tap-highlight-color: transparent; }
    
    body { 
      background-color: var(--bg-dark); 
      color: var(--text-main); 
      padding-bottom: 90px; 
      min-height: 100vh;
      position: relative;
    }

    header {
      background: var(--bg-card);
      padding: 14px 18px;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .brand-box { display: flex; align-items: center; gap: 12px; min-width: 0; flex: 1 1 auto; }
    .brand-logo { width: 46px; height: 46px; border-radius: 50%; border: 2px solid var(--primary-gold); object-fit: cover; background: #fff; box-shadow: 0 0 10px rgba(197, 160, 89, 0.4); flex-shrink: 0; }
    .brand-box > div { min-width: 0; }
    .brand-title { font-size: 16px; font-weight: 700; color: var(--primary-gold); letter-spacing: 0.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .brand-slogan { font-size: 12px; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    .bottom-nav {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      background: var(--bg-card);
      border-top: 1px solid var(--border-color);
      display: flex;
      justify-content: space-around;
      padding: 10px 0 12px 0;
      z-index: 1000;
    }
    .nav-item {
      color: var(--text-muted);
      text-align: center;
      font-size: 11px;
      cursor: pointer;
      flex: 1;
      transition: 0.2s;
    }
    .nav-item i { font-size: 20px; display: block; margin-bottom: 4px; }
    .nav-item.active { color: var(--primary-gold); font-weight: 600; }

    .container { max-width: 850px; margin: 0 auto; padding: 18px 14px; position: relative; }
    .tab-content { display: none; }
    .tab-content.active { display: block; }

    .btn-gold {
      background: var(--gold-gradient);
      color: #121316;
      border: none;
      padding: 13px 20px;
      border-radius: 9px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      font-size: 15px;
      transition: opacity 0.2s;
      box-shadow: 0 4px 12px rgba(197, 160, 89, 0.2);
    }
    .btn-gold:active { opacity: 0.85; transform: scale(0.99); }
    .btn-outline {
      background: transparent;
      border: 1px solid var(--border-color);
      color: var(--text-main);
      padding: 7px 12px;
      border-radius: 6px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
    }
    .btn-outline:hover { border-color: var(--primary-gold); color: var(--primary-gold); }
    .btn-icon-only { padding: 8px 10px; font-size: 14px; flex-shrink: 0; }
    
    .btn-remind {
      background: rgba(0, 104, 255, 0.15);
      border: 1px solid var(--zalo-blue);
      color: #4da3ff;
      padding: 6px 10px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 12px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      flex: 1;
      transition: all 0.2s;
    }
    .btn-remind:hover { background: rgba(0, 104, 255, 0.3); }

    .btn-call {
      background: rgba(46, 204, 113, 0.15);
      border: 1px solid var(--success);
      color: var(--success);
      padding: 6px 10px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 12px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      flex: 1;
      transition: all 0.2s;
      text-decoration: none;
    }
    .btn-call:hover { background: rgba(46, 204, 113, 0.3); }

    .btn-danger-outline {
      background: transparent;
      border: 1px solid var(--danger);
      color: var(--danger);
      padding: 7px 12px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 12px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      transition: all 0.2s;
    }
    .btn-danger-outline:hover { background: rgba(231, 76, 60, 0.15); }

    .card {
      background: var(--bg-card);
      border-radius: 12px;
      border: 1px solid var(--border-color);
      padding: 16px;
      margin-bottom: 14px;
    }

    .hero-banner {
      text-align: center;
      padding: 26px 15px;
      background: linear-gradient(180deg, rgba(197, 160, 89, 0.18) 0%, rgba(28, 30, 36, 1) 100%);
      border-radius: 16px;
      margin-bottom: 20px;
      border: 1px solid rgba(197, 160, 89, 0.25);
    }
    .quick-add-btn {
      width: 62px;
      height: 62px;
      border-radius: 50%;
      background: var(--gold-gradient);
      color: #121316;
      font-size: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 15px auto 0 auto;
      cursor: pointer;
      box-shadow: 0 4px 15px rgba(212, 175, 55, 0.35);
      border: none;
      transition: transform 0.2s;
    }
    .quick-add-btn:active { transform: scale(0.92); }

    .form-group { margin-bottom: 14px; min-width: 0; }
    .form-group label { display: block; font-size: 13px; color: var(--text-muted); margin-bottom: 6px; }
    .form-control {
      width: 100%;
      padding: 10px 12px;
      background: var(--bg-input);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      color: #fff;
      font-size: 14px;
    }
    .form-control:focus { outline: none; border-color: var(--primary-gold); }
    textarea.form-control { resize: vertical; line-height: 1.5; }
    
    .service-btn-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 10px; }
    .service-parent-btn {
      background: var(--bg-input);
      border: 1px solid var(--border-color);
      color: var(--text-main);
      padding: 10px 6px;
      text-align: center;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      transition: all 0.2s;
    }
    .service-parent-btn.active {
      background: rgba(197, 160, 89, 0.25);
      border-color: var(--primary-gold);
      color: var(--primary-gold);
    }
    .sub-service-container {
      background: var(--bg-dark);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 10px;
      margin-bottom: 12px;
    }
    .sub-service-grid { display: flex; flex-wrap: wrap; gap: 8px; }
    .sub-chip {
      background: var(--bg-input);
      border: 1px solid var(--border-color);
      padding: 7px 12px;
      border-radius: 20px;
      font-size: 12px;
      cursor: pointer;
      transition: all 0.2s;
      color: var(--text-muted);
    }
    .sub-chip.selected {
      background: var(--primary-gold);
      color: #121316;
      font-weight: bold;
      border-color: var(--primary-gold);
    }

    .warranty-options { display: grid; grid-template-columns: 1.35fr repeat(5, 1fr); gap: 5px; }
    .chip {
      background: var(--bg-input);
      border: 1px solid var(--border-color);
      padding: 8px 1px;
      text-align: center;
      border-radius: 8px;
      font-size: 12px;
      cursor: pointer;
      user-select: none;
      font-weight: 600;
      white-space: nowrap;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-muted);
      transition: all 0.2s;
    }
    .chip.selected { background: var(--primary-gold); border-color: var(--primary-gold); color: #121316; font-weight: 700; }

    .photo-section { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 6px; }
    .photo-box {
      border: 2px dashed var(--border-color);
      border-radius: 10px;
      padding: 6px;
      text-align: center;
      background-color: var(--bg-input);
      min-height: 115px;
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: border-color 0.2s;
    }
    .photo-box:hover { border-color: var(--primary-gold); }
    .photo-box img { width: 100%; height: 105px; object-fit: cover; border-radius: 6px; display: none; }
    .photo-placeholder { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; color: var(--text-muted); font-size: 12px; }
    .photo-placeholder i { font-size: 24px; color: var(--primary-gold); }
    .btn-remove-photo {
      position: absolute;
      top: 5px; right: 5px;
      background: rgba(231, 76, 60, 0.95);
      color: #fff;
      border: none;
      width: 26px; height: 26px;
      border-radius: 50%;
      display: none;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      cursor: pointer;
      z-index: 10;
      box-shadow: 0 2px 8px rgba(0,0,0,0.5);
    }

    .modal {
      display: none;
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0,0,0,0.85);
      z-index: 2000;
      overflow-y: auto;
      padding: 20px 12px;
    }
    #customAlertModal, #customConfirmModal { z-index: 3000; }
    .modal-content {
      background: var(--bg-card);
      max-width: 560px;
      margin: 15px auto;
      border-radius: 14px;
      border: 1px solid var(--border-color);
      padding: 22px 20px;
      position: relative;
    }
    .modal-header-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 12px;
    }
    .modal-close-btn {
      width: 32px; height: 32px;
      border-radius: 50%;
      background: var(--bg-input);
      border: 1px solid var(--border-color);
      color: var(--text-muted);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 15px;
      transition: all 0.2s;
    }
    .modal-close-btn:hover { color: #fff; border-color: var(--primary-gold); }

    .settings-tabs { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; margin-bottom: 16px; border-bottom: 1px solid var(--border-color); }
    .settings-tabs::-webkit-scrollbar { display: none; }
    .settings-tab {
      flex-shrink: 0; display: flex; align-items: center; gap: 6px; padding: 9px 12px; font-size: 12.5px; font-weight: 600; color: var(--text-muted); cursor: pointer; border-bottom: 2px solid transparent; white-space: nowrap; transition: all 0.15s;
    }
    .settings-tab:hover { color: var(--text-main); }
    .settings-tab.active { color: var(--primary-gold); border-bottom-color: var(--primary-gold); }
    .settings-tab-content { display: none; }
    .settings-tab-content.active { display: block; }

    .badge { display: inline-flex; align-items: center; gap: 4px; padding: 4px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; white-space: nowrap; }
    .badge-success { background: rgba(46, 204, 113, 0.2); color: var(--success); }
    .badge-warning { background: rgba(243, 156, 18, 0.2); color: var(--warning); }
    .badge-danger { background: rgba(231, 76, 60, 0.25); color: var(--danger); border: 1px solid rgba(231, 76, 60, 0.4); }
    .badge-secondary { background: rgba(155, 161, 166, 0.2); color: var(--text-muted); }

    .debt-panel { background: rgba(37, 40, 48, 0.85); border: 1px dashed var(--border-color); border-radius: 10px; padding: 12px; margin-bottom: 14px; }
    .debt-quick-btn {
      background: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-muted); padding: 8px 6px; border-radius: 6px; font-size: 12px; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 5px; white-space: nowrap;
    }
    .debt-quick-btn:hover { border-color: var(--primary-gold); color: var(--primary-gold); }

    .rev-preset-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 12px; }
    .rev-preset-btn {
      background: var(--bg-input); border: 1px solid var(--border-color); color: var(--text-muted); padding: 8px 4px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer; text-align: center; transition: all 0.15s;
    }
    .rev-preset-btn:hover { border-color: var(--primary-gold); color: var(--primary-gold); }
    .rev-preset-btn.active { background: rgba(197, 160, 89, 0.25); border-color: var(--primary-gold); color: var(--primary-gold); }

    .btn-warranty-status {
      padding: 6px 10px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer; border: 1px solid var(--warning); background: rgba(243, 156, 18, 0.15); color: var(--warning); display: inline-flex; align-items: center; justify-content: center; gap: 5px; flex: 1.4; transition: all 0.2s;
    }
    .btn-warranty-status:hover { opacity: 0.9; }
    .btn-warranty-status.done { border-color: var(--success); background: rgba(46, 204, 113, 0.2); color: var(--success); }

    .warranty-sub-item { background: var(--bg-input); border-radius: 8px; padding: 12px; margin-top: 8px; border-left: 3px solid var(--primary-gold); }
    .warranty-sub-item.overdue { border-left-color: var(--danger); }
    .warranty-sub-item.completed { border-left-color: var(--success); }
    .warranty-actions-row { display: flex; gap: 8px; margin-top: 10px; }
    .warranty-accordion-btn {
      display: inline-flex; align-items: center; gap: 6px; cursor: pointer; color: var(--primary-gold); font-size: 12px; background: var(--bg-dark); padding: 4px 10px; border-radius: 6px; border: 1px solid var(--border-color); transition: all 0.2s; white-space: nowrap;
    }
    .warranty-chevron { transition: transform 0.3s ease; }
    .warranty-chevron.open { transform: rotate(180deg); }
    .warranty-details-collapse { display: none; margin-top: 6px; animation: fadeIn 0.25s ease-in-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }

    .customer-item { display: flex; justify-content: space-between; align-items: center; transition: background 0.15s; }
    .customer-item:hover { background: rgba(255,255,255,0.02); }

    .stats-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-bottom: 20px; }
    .stat-card { background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 10px; padding: 14px; }
    .stat-card .value { font-size: 18px; font-weight: bold; color: var(--primary-gold); margin-top: 4px; }

    .detail-images { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px; }
    .detail-img-box { text-align: center; background: var(--bg-dark); padding: 6px; border-radius: 8px; border: 1px solid var(--border-color); }
    .detail-img-box img { width: 100%; height: 120px; object-fit: cover; border-radius: 6px; cursor: pointer; transition: transform 0.2s; }
    .detail-img-box img:hover { transform: scale(1.03); }
    .detail-img-box span { font-size: 11px; color: var(--primary-gold); display: block; margin-top: 4px; }

    #imageViewerModal {
      display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.92); z-index: 3000; justify-content: center; align-items: center; flex-direction: column; padding: 15px;
    }
    #imageViewerStage { position: relative; width: 100%; max-width: 700px; display: flex; justify-content: center; align-items: center; overflow: hidden; touch-action: none; }
    #imageViewerImg { max-width: 95%; max-height: 80vh; border-radius: 8px; border: 2px solid var(--primary-gold); object-fit: contain; box-shadow: 0 0 25px rgba(197, 160, 89, 0.5); transition: transform 0.05s linear; touch-action: none; }
    .iv-nav-arrow {
      display: none; position: absolute; top: 50%; transform: translateY(-50%); color: #fff; font-size: 20px; cursor: pointer; background: rgba(0, 0, 0, 0.45); border-radius: 50%; width: 38px; height: 38px; align-items: center; justify-content: center; z-index: 2;
    }
    .iv-nav-arrow:hover { background: rgba(0, 0, 0, 0.7); }
    #ivPrevArrow { left: 6px; }
    #ivNextArrow { right: 6px; }
    #imageViewerDots { margin-top: 10px; text-align: center; }

    @media (min-width: 900px) {
      .container { max-width: 1100px; padding: 26px 24px; }
      header { padding: 16px 26px; }
      .bottom-nav { max-width: 1100px; left: 50%; right: auto; transform: translateX(-50%); border-radius: 16px 16px 0 0; box-shadow: 0 -6px 24px rgba(0, 0, 0, 0.35); padding: 12px 0 14px 0; }
      .nav-item { padding: 4px 12px; border-radius: 10px; transition: background 0.15s; }
      .nav-item:hover { background: rgba(255, 255, 255, 0.05); }
      #customerList, #homeRecentList, #warrantyList { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; align-items: start; }
      #customerList .card, #homeRecentList > .card, #warrantyList > .card { margin-bottom: 0; }
    }

    @media (min-width: 1300px) {
      .container { max-width: 1300px; }
      #customerList, #homeRecentList, #warrantyList { grid-template-columns: 1fr 1fr 1fr; }
    }
  </style>
</head>

<body>

  <!-- HEADER -->
  <header>
    <div class="brand-box">
      <img id="brandLogo" class="brand-logo" src="" alt="Logo">
      <div>
        <div class="brand-title" id="brandTitle">Quản Lý Phun Xăm PMU</div>
        <div class="brand-slogan" id="brandSlogan">Hệ thống quản lý và chăm sóc khách hàng</div>
      </div>
    </div>
    <div style="display: flex; align-items: center; gap: 8px; flex-shrink: 0;">
      <div id="cloudSyncStatus" style="font-size: 11px; color: var(--text-muted); display: flex; align-items: center; gap: 4px; cursor: pointer; white-space: nowrap;" onclick="openSettingsModal()" title="Bấm để mở cài đặt đồng bộ">
        <i class="fa-solid fa-hard-drive"></i> <span id="cloudSyncStatusText">Chưa đăng nhập</span>
      </div>
      <button class="btn-outline btn-icon-only" onclick="openSettingsModal()" title="Cài đặt"><i class="fa-solid fa-gear"></i></button>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <div class="container">

    <!-- 1. TAB TRANG CHỦ -->
    <div id="tab-home" class="tab-content active">
      <div id="backupReminderBanner" style="display: none;"></div>
      <div class="hero-banner">
        <h2 style="color: var(--primary-gold); margin-bottom: 8px;" id="heroBrandName">Tiệm Phun Xăm Của Bạn</h2>
        <p style="color: var(--text-muted); font-size: 13px;">Hệ thống lưu trữ hồ sơ, hình ảnh & nhắc dặm tự động</p>
        <button class="quick-add-btn" onclick="openAddCustomerModal()"><i class="fa-solid fa-plus"></i></button>
        <div style="font-size: 13px; font-weight: 600; margin-top: 10px; color: var(--primary-gold);">Thêm khách hàng mới</div>
      </div>

      <h3 style="margin-bottom: 12px; font-size: 15px;"><i class="fa-solid fa-clock-rotate-left"></i> Khách hàng gần đây</h3>
      <div id="homeRecentList"></div>
    </div>

    <!-- 2. TAB KHÁCH HÀNG -->
    <div id="tab-customers" class="tab-content">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
        <h3 style="font-size: 16px; color: var(--primary-gold);"><i class="fa-solid fa-users"></i> Hồ sơ khách hàng</h3>
        <button class="btn-gold" style="padding: 8px 14px; font-size: 13px; width: auto;" onclick="openAddCustomerModal()"><i class="fa-solid fa-user-plus"></i> Thêm khách</button>
      </div>
      <div class="form-group">
        <input type="text" id="customerSearchInput" class="form-control" placeholder="Tìm theo Tên, SĐT, Địa chỉ..." oninput="renderCustomerList()">
      </div>
      <div id="customerSelectBar" style="display: none;"></div>
      <div id="customerList"></div>
    </div>

    <!-- 3. TAB LỊCH HẸN & BẢO HÀNH -->
    <div id="tab-appointments" class="tab-content">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
        <h3 style="font-size: 16px; color: var(--primary-gold);"><i class="fa-solid fa-calendar-check"></i> Lịch hẹn khách</h3>
        <button class="btn-gold" style="padding: 8px 14px; font-size: 13px; width: auto;" onclick="openAppointmentModal()"><i class="fa-solid fa-calendar-plus"></i> Thêm lịch hẹn</button>
      </div>
      <div class="form-group">
        <input type="text" id="appointmentSearchInput" class="form-control" placeholder="Tìm theo Tên, SĐT, Dịch vụ..." oninput="renderAppointmentList()">
      </div>
      <div id="appointmentList"></div>
    </div>

    <div id="tab-warranty" class="tab-content">
      <h3 style="font-size: 16px; color: var(--primary-gold); margin-bottom: 12px;"><i class="fa-solid fa-shield-halved"></i> Danh sách bảo hành & Nhắc lịch</h3>
      <div class="form-group">
        <input type="text" id="warrantySearchInput" class="form-control" placeholder="Tìm theo Tên, SĐT, Địa chỉ, Dịch vụ..." oninput="renderWarrantyList()">
      </div>
      <div id="warrantyList"></div>
    </div>

    <!-- 4. TAB DOANH THU -->
    <div id="tab-revenue" class="tab-content">
      <div id="revenueLockScreen" style="text-align: center; padding: 40px 10px;">
        <i class="fa-solid fa-lock" style="font-size: 40px; color: var(--primary-gold); margin-bottom: 15px;"></i>
        <h3>Khu vực bảo mật doanh thu</h3>
        <p style="color: var(--text-muted); font-size: 13px; margin: 8px 0 12px 0;">Vui lòng nhập mật mã (Mặc định: <strong>123456</strong>)</p>
        <div style="max-width: 260px; margin: 0 auto;">
          <input type="password" id="passcodeInput" class="form-control" placeholder="Nhập mật mã..." style="text-align: center; font-size: 18px; letter-spacing: 4px; margin-bottom: 12px;">
          <button class="btn-gold" onclick="unlockRevenue()"><i class="fa-solid fa-key"></i> Mở khóa</button>
        </div>
      </div>

      <div id="revenueContent" style="display: none;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
          <h3 style="font-size: 16px; color: var(--primary-gold);"><i class="fa-solid fa-wallet"></i> Báo cáo doanh thu</h3>
          <button class="btn-outline" style="font-size: 12px;" onclick="lockRevenue()"><i class="fa-solid fa-lock"></i> Khóa lại</button>
        </div>

        <div class="stats-grid">
          <div class="stat-card">
            <div style="font-size: 12px; color: var(--text-muted);">Doanh thu hôm nay (Thực thu)</div>
            <div class="value" id="revToday">0 đ</div>
          </div>
          <div class="stat-card">
            <div style="font-size: 12px; color: var(--text-muted);">Doanh thu tháng này (Thực thu)</div>
            <div class="value" id="revMonth">0 đ</div>
          </div>
        </div>

        <div class="card">
          <h4 style="font-size: 14px; margin-bottom: 10px;"><i class="fa-solid fa-bolt"></i> Xem nhanh doanh thu</h4>
          <div class="rev-preset-grid">
            <button type="button" class="rev-preset-btn" onclick="applyRevenuePreset('this_week', this)">Tuần này</button>
            <button type="button" class="rev-preset-btn" onclick="applyRevenuePreset('last_week', this)">Tuần trước</button>
            <button type="button" class="rev-preset-btn active" id="btnPresetThisMonth" onclick="applyRevenuePreset('this_month', this)">Tháng này</button>
            <button type="button" class="rev-preset-btn" onclick="applyRevenuePreset('last_month', this)">Tháng trước</button>
            <button type="button" class="rev-preset-btn" onclick="applyRevenuePreset('this_year', this)">Năm nay</button>
            <button type="button" class="rev-preset-btn" onclick="applyRevenuePreset('last_year', this)">Năm trước</button>
          </div>

          <h4 style="font-size: 14px; margin-top: 14px; margin-bottom: 10px;"><i class="fa-solid fa-filter"></i> Lọc theo khoảng ngày tùy chọn</h4>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
            <div>
              <label style="font-size: 12px; color: var(--text-muted); display: block; margin-bottom: 5px;">Từ ngày</label>
              <input type="date" id="revStartDate" class="form-control" onchange="clearRevenuePresetActive()">
            </div>
            <div>
              <label style="font-size: 12px; color: var(--text-muted); display: block; margin-bottom: 5px;">Đến ngày</label>
              <input type="date" id="revEndDate" class="form-control" onchange="clearRevenuePresetActive()">
            </div>
          </div>
          <button class="btn-gold" style="padding: 10px;" onclick="filterRevenue()"><i class="fa-solid fa-magnifying-glass"></i> Xem thống kê</button>
          <div style="margin-top: 12px; font-weight: bold; text-align: right; color: var(--primary-gold); font-size: 15px;" id="filteredRevResult">Tổng: 0 đ</div>
        </div>

        <div class="card">
          <h4 style="font-size: 14px; margin-bottom: 10px;" id="serviceStatsTitle">Thống kê theo loại dịch vụ</h4>
          <div id="serviceStatsList"></div>
        </div>

        <div class="card">
          <h4 style="font-size: 14px; margin-bottom: 10px;" id="customerRevTitle">Doanh thu theo từng khách hàng</h4>
          <div id="customerRevList"></div>
        </div>
      </div>
    </div>

  </div>

  <!-- MODAL KHÓA HẾT HẠN DÙNG THỬ / BẢN QUYỀN (LOCK MODAL) -->
  <div id="licenseLockModal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(18, 19, 22, 0.98); z-index: 9999; padding: 25px 16px; overflow-y: auto;">
    <div style="max-width: 440px; margin: 30px auto; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 14px; padding: 24px; text-align: center;">
      <div style="width: 60px; height: 60px; border-radius: 50%; background: rgba(231, 76, 60, 0.15); color: var(--danger); font-size: 28px; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px auto;">
        <i class="fa-solid fa-lock"></i>
      </div>
      
      <h3 style="color: var(--primary-gold); font-size: 18px; margin-bottom: 8px;">Hết Hạn Trải Nghiệm Phần Mềm</h3>
      <p id="lockReasonText" style="color: var(--text-muted); font-size: 13px; line-height: 1.6; margin-bottom: 20px;">
        Thời gian dùng thử 3 ngày miễn phí đã kết thúc. Vui lòng kích hoạt bản quyền để tiếp tục sử dụng đầy đủ các tính năng!
      </p>

      <div class="form-group" style="text-align: left; margin-bottom: 12px;">
        <label style="font-size: 12px; color: var(--text-muted);">Nhập mã kích hoạt bản quyền (License Key):</label>
        <input type="text" id="licenseKeyInput" class="form-control" placeholder="Ví dụ: TEST3, TEST1P hoặc PMU-VIP" style="text-transform: uppercase; font-weight: bold; letter-spacing: 1px; text-align: center;">
      </div>
      <button class="btn-gold" style="width: 100%; margin-bottom: 15px;" onclick="activateLicenseKey()"><i class="fa-solid fa-key"></i> Kích hoạt ngay</button>

      <div style="border-top: 1px dashed var(--border-color); padding-top: 15px; margin-top: 15px;">
        <div style="font-size: 12px; color: var(--text-muted); margin-bottom: 10px;">Chưa có mã kích hoạt? Liên hệ quản trị viên:</div>
        <a href="https://zalo.me" target="_blank" class="btn-outline" style="width: 100%; justify-content: center; padding: 10px; border-color: var(--zalo-blue); color: #4da3ff; text-decoration: none;">
          <i class="fa-solid fa-comment-dots"></i> Nhắn tin Zalo hỗ trợ
        </a>
        <button class="btn-danger-outline" style="width: 100%; justify-content: center; margin-top: 10px; padding: 8px;" onclick="cloudSignOut()"><i class="fa-solid fa-right-from-bracket"></i> Đăng xuất tài khoản</button>
      </div>
    </div>
  </div>

  <!-- MODAL: THÊM / SỬA KHÁCH HÀNG -->
  <div id="customerModal" class="modal">
    <div class="modal-content">
      <div class="modal-header-top">
        <h3 id="modalTitle" style="color: var(--primary-gold); font-size: 17px;">Thêm khách hàng mới</h3>
        <div class="modal-close-btn" onclick="closeModal('customerModal')"><i class="fa-solid fa-xmark"></i></div>
      </div>
      
      <input type="hidden" id="custEditId">
      <input type="hidden" id="custSessionEditId">
      <input type="hidden" id="isAddingSessionOnly" value="false">

      <div id="personalInfoFields">
        <div class="form-group">
          <label>Họ và tên (*)</label>
          <input type="text" id="custName" class="form-control" placeholder="Ví dụ: Nguyễn Thị Mai">
        </div>
        <div class="form-group">
          <label>Số điện thoại (*)</label>
          <input type="tel" id="custPhone" class="form-control" placeholder="Ví dụ: 0908123456">
        </div>
        <div class="form-group">
          <label>Địa chỉ</label>
          <input type="text" id="custAddress" class="form-control" placeholder="Ví dụ: Phường 1...">
        </div>
      </div>

      <div class="form-group">
        <label>Dịch vụ thực hiện (* Nhấn nhóm để chọn chi tiết)</label>
        <div class="service-btn-grid">
          <div class="service-parent-btn active" id="btn-grp-moi" onclick="toggleServiceGroup('moi')"><span>Môi</span></div>
          <div class="service-parent-btn" id="btn-grp-may" onclick="toggleServiceGroup('may')"><span>Mày</span></div>
          <div class="service-parent-btn" id="btn-grp-mi" onclick="toggleServiceGroup('mi')"><span>Mí</span></div>
          <div class="service-parent-btn" id="btn-grp-combo" onclick="toggleServiceGroup('combo')"><span>Combo</span></div>
          <div class="service-parent-btn" id="btn-grp-nhuhoa" onclick="toggleServiceGroup('nhuhoa')"><span>Nhũ hoa</span></div>
          <div class="service-parent-btn" id="btn-grp-xoa" onclick="toggleServiceGroup('xoa')"><span>Xóa</span></div>
        </div>

        <div class="sub-service-container" id="subServiceContainer">
          <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 6px;" id="subServiceTitle">Chọn loại dịch vụ Môi:</div>
          <div class="sub-service-grid" id="subServiceGrid"></div>
        </div>
        <input type="hidden" id="custService" value="Phun môi">
        <div style="font-size: 12px; color: var(--primary-gold); margin-top: -6px; margin-bottom: 10px;">
          Dịch vụ đã chọn: <strong id="displaySelectedService">Phun môi</strong>
        </div>
      </div>

      <div class="form-group">
        <label>Tình trạng ban đầu</label>
        <textarea id="custPreStatus" class="form-control" rows="2" placeholder="Ví dụ: Môi thâm viền, mày nhạt..."></textarea>
      </div>

      <div class="form-group">
        <label>Giải pháp thực hiện</label>
        <textarea id="custProcess" class="form-control" rows="2" placeholder="Ví dụ: Khử thâm cam tươi..."></textarea>
      </div>

      <div class="form-group">
        <label>Màu đã pha</label>
        <textarea id="custColorMix" class="form-control" rows="2" placeholder="Ví dụ: Đỏ cam đào..."></textarea>
      </div>

      <div class="form-group">
        <label>Hình ảnh đối chiếu (Trước & Sau khi làm)</label>
        <div class="photo-section">
          <div class="photo-box" id="boxBefore" onclick="triggerPhotoSelect('before')">
            <button type="button" class="btn-remove-photo" id="btnDelBefore" title="Xóa ảnh trước" onclick="event.stopPropagation(); removePhoto('before')">✕</button>
            <div class="photo-placeholder" id="textBefore">
              <i class="fa-solid fa-camera-retro"></i>
              <span>Chụp / Tải ảnh Trước</span>
            </div>
            <img id="previewBefore" alt="Ảnh Trước" onclick="event.stopPropagation(); openImageViewerFromForm('before')">
            <input type="file" id="imgBeforeInput" accept="image/*" style="display:none;" onchange="handleImageUpload(event, 'previewBefore', 'textBefore', 'before')">
          </div>

          <div class="photo-box" id="boxAfter" onclick="triggerPhotoSelect('after')">
            <button type="button" class="btn-remove-photo" id="btnDelAfter" title="Xóa ảnh sau" onclick="event.stopPropagation(); removePhoto('after')">✕</button>
            <div class="photo-placeholder" id="textAfter">
              <i class="fa-solid fa-camera-retro"></i>
              <span>Chụp / Tải ảnh Sau</span>
            </div>
            <img id="previewAfter" alt="Ảnh Sau" onclick="event.stopPropagation(); openImageViewerFromForm('after')">
            <input type="file" id="imgAfterInput" accept="image/*" style="display:none;" onchange="handleImageUpload(event, 'previewAfter', 'textAfter', 'after')">
          </div>
        </div>
      </div>

      <div class="form-group">
        <label>Thời gian làm</label>
        <input type="datetime-local" id="custDate" class="form-control">
      </div>
      <div class="form-group">
        <label>Tổng giá tiền (VNĐ)</label>
        <input type="text" id="custPrice" class="form-control" placeholder="2.000.000" oninput="handlePriceOrPaidChange()">
      </div>

      <div class="debt-panel">
        <label style="font-size: 13px; font-weight: 700; color: var(--primary-gold); display: block; margin-bottom: 10px;"><i class="fa-solid fa-receipt"></i> Thanh toán & Công nợ</label>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 8px;">
          <button type="button" class="debt-quick-btn" onclick="setFullPayment()"><i class="fa-solid fa-check"></i> Trả đủ</button>
          <button type="button" class="debt-quick-btn" onclick="setZeroPayment()"><i class="fa-solid fa-hand-holding-dollar"></i> Nợ 100%</button>
        </div>
        <button type="button" class="debt-quick-btn" style="width: 100%; padding: 10px; font-size: 13px; font-weight: 600; border-color: var(--primary-gold); color: var(--primary-gold); background: rgba(212, 175, 55, 0.08); margin-bottom: 14px;" onclick="saveCustomerData(true)">
          <i class="fa-solid fa-qrcode"></i> Lưu & Tạo mã thanh toán
        </button>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
          <div>
            <label style="font-size: 12px; color: var(--text-muted); display: block; margin-bottom: 4px;">Đã trả (VNĐ)</label>
            <input type="text" id="custPaid" class="form-control" placeholder="0" oninput="handlePriceOrPaidChange()" style="border-color: rgba(46, 204, 113, 0.4);">
          </div>
          <div>
            <label style="font-size: 12px; color: var(--text-muted); display: block; margin-bottom: 4px;">Nợ còn lại (VNĐ)</label>
            <input type="text" id="custDebt" class="form-control" placeholder="0 đ" readonly style="background: var(--bg-dark); color: var(--danger); font-weight: bold; border-color: rgba(231, 76, 60, 0.4);">
          </div>
        </div>
      </div>

      <div class="form-group">
        <label>Thời hạn bảo hành (Tháng)</label>
        <div class="warranty-options">
          <div class="chip" onclick="selectWarranty(this, 0)">Không BH</div>
          <div class="chip selected" onclick="selectWarranty(this, 1)">1T</div>
          <div class="chip" onclick="selectWarranty(this, 2)">2T</div>
          <div class="chip" onclick="selectWarranty(this, 3)">3T</div>
          <div class="chip" onclick="selectWarranty(this, 6)">6T</div>
          <div class="chip" onclick="selectWarranty(this, 12)">12T</div>
        </div>
        <input type="hidden" id="custWarrantyMonths" value="1">
      </div>

      <button class="btn-gold" style="margin-top: 10px;" onclick="saveCustomerData()"><i class="fa-solid fa-floppy-disk"></i> Lưu hồ sơ</button>
    </div>
  </div>

  <!-- MODAL: XEM CHI TIẾT KHÁCH HÀNG -->
  <div id="customerDetailModal" class="modal">
    <div class="modal-content">
      <div class="modal-header-top">
        <h3 style="color: var(--primary-gold); font-size: 17px;"><i class="fa-solid fa-id-card"></i> Hồ sơ chi tiết</h3>
        <div class="modal-close-btn" onclick="closeModal('customerDetailModal')" title="Đóng cửa sổ">
          <i class="fa-solid fa-xmark"></i>
        </div>
      </div>
      <div id="customerDetailContent"></div>
    </div>
  </div>

  <!-- MODAL: THÊM / SỬA LỊCH HẸN -->
  <div id="appointmentModal" class="modal">
    <div class="modal-content">
      <div class="modal-header-top">
        <h3 id="appointmentModalTitle" style="color: var(--primary-gold); font-size: 17px;"><i class="fa-solid fa-calendar-plus"></i> Thêm lịch hẹn</h3>
        <div class="modal-close-btn" onclick="closeModal('appointmentModal')"><i class="fa-solid fa-xmark"></i></div>
      </div>
      <input type="hidden" id="apptEditId">

      <div class="form-group">
        <label>Tên khách hàng</label>
        <input type="text" id="apptName" class="form-control" placeholder="Nhập tên khách...">
      </div>
      <div class="form-group">
        <label>Số điện thoại</label>
        <input type="tel" id="apptPhone" class="form-control" placeholder="Nhập số điện thoại...">
      </div>
      <div class="form-group">
        <label>Dịch vụ dự kiến</label>
        <div class="service-btn-grid">
          <div class="service-parent-btn active" id="appt-btn-grp-moi" onclick="toggleApptServiceGroup('moi')"><span>Môi</span></div>
          <div class="service-parent-btn" id="appt-btn-grp-may" onclick="toggleApptServiceGroup('may')"><span>Mày</span></div>
          <div class="service-parent-btn" id="appt-btn-grp-mi" onclick="toggleApptServiceGroup('mi')"><span>Mí</span></div>
          <div class="service-parent-btn" id="appt-btn-grp-combo" onclick="toggleApptServiceGroup('combo')"><span>Combo</span></div>
          <div class="service-parent-btn" id="appt-btn-grp-nhuhoa" onclick="toggleApptServiceGroup('nhuhoa')"><span>Nhũ hoa</span></div>
          <div class="service-parent-btn" id="appt-btn-grp-xoa" onclick="toggleApptServiceGroup('xoa')"><span>Xóa</span></div>
        </div>

        <div class="sub-service-container" id="apptSubServiceContainer">
          <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 6px;" id="apptSubServiceTitle">Chọn loại dịch vụ Môi:</div>
          <div class="sub-service-grid" id="apptSubServiceGrid"></div>
        </div>
        <input type="hidden" id="apptService" value="">
        <div style="font-size: 12px; color: var(--primary-gold); margin-top: -6px;">
          Dịch vụ đã chọn: <strong id="apptDisplaySelectedService">-</strong>
        </div>
      </div>
      <div class="form-group">
        <label>Ngày giờ hẹn</label>
        <input type="datetime-local" id="apptDateTime" class="form-control">
      </div>
      <div class="form-group">
        <label>Ghi chú</label>
        <textarea id="apptNote" class="form-control" rows="2" placeholder="Ghi chú thêm..."></textarea>
      </div>

      <button class="btn-gold" onclick="saveAppointmentData()"><i class="fa-solid fa-check"></i> Lưu lịch hẹn</button>
    </div>
  </div>

  <!-- MODAL: GỬI TIN NHẮN NHẮC BẢO HÀNH -->
  <div id="remindModal" class="modal">
    <div class="modal-content">
      <div class="modal-header-top">
        <h3 style="color: var(--primary-gold); font-size: 16px;"><i class="fa-solid fa-paper-plane"></i> Gửi tin nhắn nhắc bảo hành</h3>
        <div class="modal-close-btn" onclick="closeModal('remindModal')"><i class="fa-solid fa-xmark"></i></div>
      </div>

      <div style="font-size: 13px; margin-bottom: 12px; line-height: 1.5; color: var(--text-muted);">
        Khách hàng: <strong id="remindCustName" style="color:#fff;"></strong> &bull; SĐT: <strong id="remindCustPhone" style="color:var(--primary-gold);"></strong>
      </div>

      <div class="form-group">
        <label>Nội dung tin nhắn:</label>
        <textarea id="remindMessageBody" class="form-control" style="height: 140px; line-height: 1.5; font-size: 13px;"></textarea>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 8px;">
        <button class="btn-gold" style="background: #0068ff; color: #fff; padding: 11px;" onclick="sendViaZalo()">
          <i class="fa-solid fa-comment-dots"></i> Gửi Zalo
        </button>
        <button class="btn-gold" style="background: #27ae60; color: #fff; padding: 11px;" onclick="sendViaSMS()">
          <i class="fa-solid fa-message"></i> Gửi SMS
        </button>
      </div>
      
      <button class="btn-outline" style="width: 100%; justify-content: center; padding: 10px;" onclick="copyReminderText()">
        <i class="fa-regular fa-copy"></i> Sao chép nội dung tin nhắn
      </button>
    </div>
  </div>

  <!-- MODAL THÔNG BÁO VÀ XÁC NHẬN -->
  <div id="customAlertModal" class="modal">
    <div class="modal-content" style="max-width: 360px; text-align: center;">
      <div style="font-size: 32px; color: var(--primary-gold); margin-bottom: 10px;"><i class="fa-solid fa-circle-info"></i></div>
      <div id="customAlertMessage" style="font-size: 14px; color: #fff; white-space: pre-line; line-height: 1.6; margin-bottom: 18px;"></div>
      <button class="btn-gold" onclick="closeCustomAlert()">OK</button>
    </div>
  </div>

  <div id="customConfirmModal" class="modal">
    <div class="modal-content" style="max-width: 360px; text-align: center;">
      <div style="font-size: 32px; color: var(--warning); margin-bottom: 10px;"><i class="fa-solid fa-triangle-exclamation"></i></div>
      <div id="customConfirmMessage" style="font-size: 14px; color: #fff; white-space: pre-line; line-height: 1.6; margin-bottom: 18px;"></div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
        <button class="btn-outline" style="justify-content: center; padding: 10px;" onclick="resolveCustomConfirm(false)">Huỷ</button>
        <button class="btn-gold" onclick="resolveCustomConfirm(true)">OK</button>
      </div>
    </div>
  </div>

  <!-- LIGHTBOX XEM ẢNH -->
  <div id="imageViewerModal" onclick="closeImageViewer()">
    <div style="width: 100%; max-width: 700px; text-align: right; margin-bottom: 8px;">
      <span onclick="event.stopPropagation(); closeImageViewer()" style="color: #fff; font-size: 24px; cursor: pointer; padding: 5px 12px; background: rgba(255,255,255,0.15); border-radius: 50%;"><i class="fa-solid fa-xmark"></i></span>
    </div>
    <div id="imageViewerStage" ontouchstart="ivTouchStart(event)" ontouchmove="ivTouchMove(event)" ontouchend="ivTouchEnd(event)" ontouchcancel="ivTouchEnd(event)">
      <img id="imageViewerImg" src="" alt="Ảnh phóng to" onclick="event.stopPropagation()">
      <div id="ivPrevArrow" class="iv-nav-arrow" onclick="event.stopPropagation(); ivGoPrev()"><i class="fa-solid fa-chevron-left"></i></div>
      <div id="ivNextArrow" class="iv-nav-arrow" onclick="event.stopPropagation(); ivGoNext()"><i class="fa-solid fa-chevron-right"></i></div>
    </div>
    <div id="imageViewerDots"></div>
    <div id="imageViewerCaption" style="color: var(--primary-gold); margin-top: 10px; font-weight: 600; font-size: 14px;"></div>
  </div>

  <!-- POPUP NHẮC VIỆC HÀNG NGÀY -->
  <div id="autoWarrantyReminderModal" class="modal">
    <div class="modal-content" style="max-width: 420px;">
      <div class="modal-header-top">
        <h3 style="color: var(--primary-gold); font-size: 17px;"><i class="fa-solid fa-bell"></i> Nhắc việc hôm nay</h3>
      </div>
      <div id="autoAppointmentReminderSection" style="display: none; margin-bottom: 16px;">
        <p style="font-size: 12.5px; font-weight: 700; color: #fff; margin-bottom: 8px;"><i class="fa-solid fa-calendar-check" style="color: var(--primary-gold);"></i> Lịch hẹn hôm nay</p>
        <div id="autoAppointmentReminderList" style="max-height: 32vh; overflow-y: auto;"></div>
      </div>
      <div id="autoWarrantyReminderSection" style="display: none;">
        <p style="font-size: 12.5px; font-weight: 700; color: #fff; margin-bottom: 8px;"><i class="fa-solid fa-shield-halved" style="color: var(--primary-gold);"></i> Bảo hành sắp/quá hạn</p>
        <div id="autoWarrantyReminderList" style="max-height: 32vh; overflow-y: auto;"></div>
      </div>
      <button class="btn-gold" style="margin-top: 12px;" onclick="closeAutoWarrantyReminderPopup()"><i class="fa-solid fa-check"></i> Đã xem</button>
    </div>
  </div>

  <!-- MODAL: VIETQR THANH TOÁN -->
  <div id="paymentQrModal" class="modal">
    <div class="modal-content" style="max-width: 380px; text-align: center;">
      <div class="modal-header-top">
        <h3 style="color: var(--primary-gold); font-size: 17px;"><i class="fa-solid fa-qrcode"></i> Quét mã thanh toán</h3>
        <div class="modal-close-btn" onclick="closeModal('paymentQrModal')"><i class="fa-solid fa-xmark"></i></div>
      </div>
      <div id="paymentQrContent"></div>
    </div>
  </div>

  <!-- MODAL: ĐĂNG NHẬP / TẠO TÀI KHOẢN -->
  <div id="cloudLoginModal" class="modal">
    <div class="modal-content">
      <div class="modal-header-top">
        <h3 style="color: var(--primary-gold); font-size: 17px;"><i class="fa-solid fa-cloud"></i> Đăng nhập tài khoản</h3>
        <div class="modal-close-btn" onclick="closeModal('cloudLoginModal')"><i class="fa-solid fa-xmark"></i></div>
      </div>
      <p style="font-size: 12.5px; color: var(--text-muted); line-height: 1.6; margin-bottom: 14px;">
        Đăng nhập để đồng bộ dữ liệu trên nhiều thiết bị và kích hoạt hạn sử dụng. Khách hàng mới bấm "Tạo tài khoản mới" để nhận 3 ngày dùng thử.
      </p>
      <div class="form-group">
        <label>Email tiệm của bạn</label>
        <input type="email" id="cloudEmail" class="form-control" placeholder="vidu@gmail.com">
      </div>
      <div class="form-group">
        <label>Mật khẩu (tối thiểu 6 ký tự)</label>
        <input type="password" id="cloudPassword" class="form-control" placeholder="••••••">
      </div>
      <div id="cloudLoginError" style="color: var(--danger); font-size: 12px; margin-bottom: 10px; display: none;"></div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
        <button class="btn-outline" style="justify-content: center; padding: 11px;" onclick="cloudSignUp()"><i class="fa-solid fa-user-plus"></i> Tạo tài khoản mới</button>
        <button class="btn-gold" onclick="cloudSignIn()"><i class="fa-solid fa-right-to-bracket"></i> Đăng nhập</button>
      </div>
    </div>
  </div>

  <!-- MODAL CÀI ĐẶT -->
  <div id="settingsModal" class="modal">
    <div class="modal-content">
      <div class="modal-header-top">
        <h3 style="color: var(--primary-gold); font-size: 17px;"><i class="fa-solid fa-sliders"></i> Cài đặt & Bản quyền</h3>
        <div class="modal-close-btn" onclick="closeModal('settingsModal')"><i class="fa-solid fa-xmark"></i></div>
      </div>

      <div class="settings-tabs">
        <div class="settings-tab active" data-tab="store" onclick="switchSettingsTab('store', this)"><i class="fa-solid fa-store"></i> Cửa hàng</div>
        <div class="settings-tab" data-tab="security" onclick="switchSettingsTab('security', this)"><i class="fa-solid fa-lock"></i> Bảo mật</div>
        <div class="settings-tab" data-tab="payment" onclick="switchSettingsTab('payment', this)"><i class="fa-solid fa-qrcode"></i> Thanh toán</div>
        <div class="settings-tab" data-tab="sync" onclick="switchSettingsTab('sync', this)"><i class="fa-solid fa-cloud"></i> Bản quyền & Đồng bộ</div>
      </div>

      <!-- TAB: Cửa hàng -->
      <div class="settings-tab-content active" id="settingsTab-store">
        <div class="form-group">
          <label>Tên cửa hàng</label>
          <input type="text" id="settingTitle" class="form-control">
        </div>
        <div class="form-group">
          <label>Slogan chào mừng</label>
          <input type="text" id="settingSlogan" class="form-control">
        </div>
        <div class="form-group">
          <label>Logo cửa hàng</label>
          <div style="display: flex; align-items: center; gap: 14px;">
            <img id="settingLogoPreview" src="" alt="Logo" style="width: 72px; height: 72px; border-radius: 50%; object-fit: cover; border: 2px solid var(--primary-gold); background: #111;">
            <div style="display: flex; flex-direction: column; gap: 6px;">
              <button type="button" class="btn-outline" style="padding: 7px 12px; font-size: 12px;" onclick="document.getElementById('settingLogoFileInput').click()"><i class="fa-solid fa-camera-retro"></i> Tải ảnh logo</button>
            </div>
          </div>
          <input type="file" id="settingLogoFileInput" accept="image/*" style="display: none;" onchange="handleLogoUpload(event)">
          <input type="hidden" id="settingLogo">
        </div>
        <div class="form-group">
          <label>Mẫu tin nhắn nhắc bảo hành ({TEN_KH}, {DICH_VU}, {HAN_BH}, {TEN_TIEM})</label>
          <textarea id="settingMsgTemplate" class="form-control" style="height: 90px; font-size: 13px;"></textarea>
        </div>
      </div>

      <!-- TAB: Bảo mật -->
      <div class="settings-tab-content" id="settingsTab-security">
        <div class="form-group">
          <label>Mật khẩu xem doanh thu hiện tại</label>
          <input type="password" id="settingOldPasscode" class="form-control" placeholder="Nhập mật khẩu hiện tại...">
        </div>
        <div class="form-group">
          <label>Đổi mật khẩu mới (Bỏ trống nếu không đổi)</label>
          <input type="password" id="settingPasscode" class="form-control" placeholder="Nhập mật khẩu mới...">
        </div>
      </div>

      <!-- TAB: Thanh toán VietQR -->
      <div class="settings-tab-content" id="settingsTab-payment">
        <div style="background: var(--bg-dark); padding: 12px; border-radius: 8px; border: 1px solid var(--border-color);">
          <label style="color: var(--primary-gold); font-weight: 600; margin-bottom: 8px; display: block;"><i class="fa-solid fa-qrcode"></i> Cấu hình VietQR nhận tiền</label>
          <div class="form-group" style="margin-bottom: 8px;">
            <label style="font-size: 12px;">Ngân hàng</label>
            <select id="settingBankId" class="form-control"></select>
          </div>
          <div class="form-group" style="margin-bottom: 8px;">
            <label style="font-size: 12px;">Số tài khoản</label>
            <input type="text" id="settingBankAccountNo" class="form-control" placeholder="VD: 0123456789">
          </div>
          <div class="form-group" style="margin-bottom: 0;">
            <label style="font-size: 12px;">Tên chủ tài khoản (viết hoa không dấu)</label>
            <input type="text" id="settingBankAccountName" class="form-control" placeholder="VD: NGUYEN VAN A">
          </div>
        </div>
      </div>

      <!-- TAB: Đồng bộ & Bản quyền -->
      <div class="settings-tab-content" id="settingsTab-sync">
        <div id="cloudSettingsBox" style="background: var(--bg-dark); padding: 12px; border-radius: 8px; border: 1px solid var(--border-color);">
          <label style="color: var(--primary-gold); font-weight: 600; margin-bottom: 8px; display: block;"><i class="fa-solid fa-shield"></i> Thông tin bản quyền & Đồng bộ</label>
          <div id="cloudSettingsContent" style="font-size: 12px; color: var(--text-muted);">Đang tải...</div>
        </div>

        <div style="background: var(--bg-dark); padding: 12px; border-radius: 8px; border: 1px solid var(--border-color); margin-top: 15px;">
          <label style="color: var(--primary-gold); font-weight: 600; margin-bottom: 8px; display: block;"><i class="fa-solid fa-cloud-arrow-down"></i> Sao lưu file dự phòng</label>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
            <button type="button" class="btn-outline" style="justify-content: center; padding: 8px;" onclick="exportDataFile()"><i class="fa-solid fa-download"></i> Tải file sao lưu</button>
            <button type="button" class="btn-outline" style="justify-content: center; padding: 8px;" onclick="document.getElementById('importFileInput').click()"><i class="fa-solid fa-upload"></i> Nhập file dữ liệu</button>
          </div>
          <input type="file" id="importFileInput" accept=".json" style="display: none;" onchange="importDataFile(event)">
        </div>
      </div>

      <button class="btn-gold" style="margin-top: 15px;" onclick="saveBrandSettings()"><i class="fa-solid fa-check"></i> Lưu cài đặt</button>
    </div>
  </div>

  <!-- NAVIGATION CUỐI MÀN HÌNH -->
  <div class="bottom-nav">
    <div class="nav-item active" onclick="switchTab('home', this)"><i class="fa-solid fa-house"></i><span>Trang chủ</span></div>
    <div class="nav-item" onclick="switchTab('customers', this)"><i class="fa-solid fa-users"></i><span>Khách hàng</span></div>
    <div class="nav-item" onclick="switchTab('appointments', this)"><i class="fa-solid fa-calendar-check"></i><span>Lịch hẹn</span></div>
    <div class="nav-item" onclick="switchTab('warranty', this)"><i class="fa-solid fa-shield-halved"></i><span>Bảo hành</span></div>
    <div class="nav-item" onclick="switchTab('revenue', this)"><i class="fa-solid fa-wallet"></i><span>Doanh thu</span></div>
  </div>

  <script>
    const defaultBrandLogo = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 500 500'><circle cx='250' cy='250' r='240' fill='%231c1e24' stroke='%23c5a059' stroke-width='6'/><text x='250' y='270' font-family='sans-serif' font-size='72' font-weight='bold' fill='%23c5a059' text-anchor='middle'>PMU</text></svg>";
    const defaultReminderTemplate = "Dạ em chào chị {TEN_KH}, tiệm {TEN_TIEM} xin phép nhắc lịch kiểm tra và dặm bảo hành dịch vụ {DICH_VU} của chị ạ. Hạn bảo hành của chị đến ngày {HAN_BH}. Chị sắp xếp ghé tiệm để bên em hỗ trợ dặm đẹp nhất cho chị nhé!";

    // Cơ sở dữ liệu local độc lập
    localforage.config({
      name: 'PMU_PRO_APP_DB',
      storeName: 'pmu_data_store'
    });

    /* ============================================================================
       CẤU HÌNH FIREBASE MỚI (pmu-demo-phtm) ĐÃ ĐƯỢC CHÈN CHUẨN XÁC VÀO ĐÂY
       ============================================================================ */
    const firebaseConfig = {
      apiKey: "AIzaSyAnZn28fs7fOrvdsIMaQYf3DNGV8iLdxKE",
      authDomain: "pmu-demo-phtm.firebaseapp.com",
      projectId: "pmu-demo-phtm",
      storageBucket: "pmu-demo-phtm.firebasestorage.app",
      messagingSenderId: "78213388821",
      appId: "1:78213388821:web:86b339f31b1f9d1dfe4c1c",
      measurementId: "G-QNXX9R0B17"
    };

    let cloudAuth = null;
    let cloudFirestore = null;
    let cloudUser = null;
    let cloudUnsubCustomers = null;
    let cloudUnsubAppointments = null;
    let cloudUnsubBrand = null;

    let db = {
      brand: {
        title: "Quản Lý Phun Xăm PMU",
        slogan: "Hệ thống quản lý và chăm sóc khách hàng",
        logo: defaultBrandLogo,
        passcode: "123456",
        msgTemplate: defaultReminderTemplate
      },
      customers: [],
      appointments: []
    };

    function markDataChanged() {
      if (!db.brand) db.brand = {};
      db.brand.lastDataModifiedTime = Date.now();
    }

    async function saveDB() {
      try {
        await localforage.setItem('na_pmu_db', db);
      } catch (e) {
        showAppAlert("Lỗi khi lưu dữ liệu: " + e.message);
      }
    }

    async function saveDBLocalOnly() {
      try {
        await localforage.setItem('na_pmu_db', db);
      } catch (e) {
        console.error('Lỗi lưu cục bộ:', e);
      }
    }

    /* ============================================================================
       MODULE BẢN QUYỀN, DÙNG THỬ (TRIAL) & KHÓA MÀN HÌNH
       ============================================================================ */
    function checkLicenseExpiry(userData) {
      const lockModal = document.getElementById('licenseLockModal');
      const now = Date.now();
      const expireAt = (userData && userData.expireAt) ? userData.expireAt : 0;

      if (!expireAt || now > expireAt) {
        const dateStr = expireAt ? new Date(expireAt).toLocaleDateString('vi-VN') : 'Chưa kích hoạt';
        document.getElementById('lockReasonText').innerHTML = `Tài khoản đã hết hạn vào ngày: <strong style="color: #fff;">${dateStr}</strong>.<br>Vui lòng kích hoạt bản quyền để tiếp tục sử dụng dữ liệu!`;
        lockModal.style.display = 'block';
      } else {
        lockModal.style.display = 'none';
      }
    }

    async function activateLicenseKey() {
      const inputEl = document.getElementById('licenseKeyInput');
      const key = inputEl.value.trim().toUpperCase();

      if (!key) {
        showAppAlert('Vui lòng nhập mã kích hoạt!');
        return;
      }
      if (!cloudUser) {
        showAppAlert('Vui lòng đăng nhập tài khoản trước khi kích hoạt mã.');
        return;
      }

      // MÃ TEST DÀNH CHO BẠN: TEST1P (1 phút) và TEST3 (3 ngày)
      if (key === 'TEST1P' || key === 'TEST3') {
        const durationMs = (key === 'TEST1P') ? (60 * 1000) : (3 * 24 * 60 * 60 * 1000);
        const newExpire = Date.now() + durationMs;

        await cloudFirestore.collection('users').doc(cloudUser.uid).set({
          expireAt: newExpire,
          updatedAt: Date.now()
        }, { merge: true });

        inputEl.value = '';
        showAppAlert(key === 'TEST1P' ? 'Đã kích hoạt 1 PHÚT test (đợi 60 giây để xem màn hình khóa)!' : 'Đã kích hoạt 3 NGÀY trải nghiệm thành công!');
        return;
      }

      try {
        const keyRef = cloudFirestore.collection('activation_keys').doc(key);
        const userRef = cloudFirestore.collection('users').doc(cloudUser.uid);

        await cloudFirestore.runTransaction(async (transaction) => {
          const keyDoc = await transaction.get(keyRef);
          if (!keyDoc.exists) {
            throw new Error('Mã kích hoạt không tồn tại trên hệ thống!');
          }

          const keyData = keyDoc.data();
          if (keyData.used) {
            throw new Error('Mã này đã được sử dụng rồi!');
          }

          const userDoc = await transaction.get(userRef);
          const userData = userDoc.data() || {};
          const currentExpire = Math.max(Date.now(), userData.expireAt || 0);
          const addedMs = (keyData.days || 30) * 24 * 60 * 60 * 1000;
          const newExpire = currentExpire + addedMs;

          transaction.update(keyRef, {
            used: true,
            usedBy: cloudUser.email,
            usedAt: Date.now()
          });

          transaction.set(userRef, {
            expireAt: newExpire,
            updatedAt: Date.now()
          }, { merge: true });
        });

        inputEl.value = '';
        showAppAlert('Kích hoạt bản quyền thành công!');
      } catch (err) {
        showAppAlert('Lỗi kích hoạt: ' + err.message);
      }
    }

    /* ============================================================================
       FIREBASE AUTH & ĐỒNG BỘ
       ============================================================================ */
    function setCloudStatus(text, iconClass) {
      const textEl = document.getElementById('cloudSyncStatusText');
      const boxEl = document.getElementById('cloudSyncStatus');
      if (textEl) textEl.innerText = text;
      if (boxEl) boxEl.querySelector('i').className = iconClass;
    }

    function initFirebase() {
      try {
        firebase.initializeApp(firebaseConfig);
        cloudAuth = firebase.auth();
        cloudFirestore = firebase.firestore();

        cloudAuth.onAuthStateChanged(function(user) {
          cloudUser = user;
          if (user) {
            setCloudStatus('Đã kết nối', 'fa-solid fa-cloud-arrow-up');
            closeModal('cloudLoginModal');
            startCloudSync();
          } else {
            setCloudStatus('Chưa đăng nhập', 'fa-solid fa-cloud-arrow-down');
            stopCloudSync();
            document.getElementById('cloudLoginModal').style.display = 'block';
          }
          renderCloudSettingsBox();
        });
      } catch (err) {
        console.error('Lỗi Firebase:', err);
      }
    }

    function renderCloudSettingsBox() {
      const el = document.getElementById('cloudSettingsContent');
      if (!el) return;

      if (cloudUser) {
        el.innerHTML = `
          <div style="margin-bottom: 8px;">Tài khoản: <strong style="color: #fff;">${escapeHtml(cloudUser.email)}</strong></div>
          <div style="margin-bottom: 12px; color: var(--primary-gold);">Hạn dùng: <span id="licenseExpiryDisplay">Đang tải...</span></div>
          <div class="form-group" style="margin-bottom: 10px;">
            <input type="text" id="settingLicenseKeyInput" class="form-control" placeholder="Nhập mã kích hoạt (Key)..." style="text-transform: uppercase;">
          </div>
          <button type="button" class="btn-gold" style="padding: 8px; margin-bottom: 10px;" onclick="activateLicenseKeyFromSettings()"><i class="fa-solid fa-key"></i> Kích hoạt gói</button>
          <button type="button" class="btn-danger-outline" style="width: 100%; justify-content: center; padding: 8px;" onclick="cloudSignOut()"><i class="fa-solid fa-right-from-bracket"></i> Đăng xuất</button>
        `;
        updateLicenseDisplay();
      } else {
        el.innerHTML = `
          <div style="margin-bottom: 10px;">Chưa đăng nhập tài khoản.</div>
          <button type="button" class="btn-gold" style="padding: 9px;" onclick="closeModal('settingsModal'); document.getElementById('cloudLoginModal').style.display='block';"><i class="fa-solid fa-right-to-bracket"></i> Đăng nhập / Tạo tài khoản</button>
        `;
      }
    }

    async function updateLicenseDisplay() {
      if (!cloudUser || !cloudFirestore) return;
      const doc = await cloudFirestore.collection('users').doc(cloudUser.uid).get();
      const expEl = document.getElementById('licenseExpiryDisplay');
      if (doc.exists && expEl) {
        const data = doc.data();
        const exp = data.expireAt || 0;
        expEl.innerText = exp ? new Date(exp).toLocaleDateString('vi-VN') : 'Hết hạn';
      }
    }

    function activateLicenseKeyFromSettings() {
      const input = document.getElementById('settingLicenseKeyInput');
      document.getElementById('licenseKeyInput').value = input.value;
      activateLicenseKey();
    }

    function cloudSignUp() {
      const email = document.getElementById('cloudEmail').value.trim();
      const pass = document.getElementById('cloudPassword').value;
      if (!email || pass.length < 6) {
        document.getElementById('cloudLoginError').innerText = 'Email không hợp lệ hoặc mật khẩu dưới 6 ký tự!';
        document.getElementById('cloudLoginError').style.display = 'block';
        return;
      }

      cloudAuth.createUserWithEmailAndPassword(email, pass)
        .then(function(userCredential) {
          const uid = userCredential.user.uid;
          const THREE_DAYS_MS = 3 * 24 * 60 * 60 * 1000;
          const now = Date.now();

          // Cấp 3 ngày dùng thử tự động
          return cloudFirestore.collection('users').doc(uid).set({
            email: email,
            trialStartedAt: now,
            expireAt: now + THREE_DAYS_MS,
            createdAt: now
          }, { merge: true });
        })
        .then(function() {
          showAppAlert("Tạo tài khoản thành công! Bạn nhận được 3 ngày trải nghiệm miễn phí.");
        })
        .catch(function(err) {
          document.getElementById('cloudLoginError').innerText = 'Lỗi: ' + err.message;
          document.getElementById('cloudLoginError').style.display = 'block';
        });
    }

    function cloudSignIn() {
      const email = document.getElementById('cloudEmail').value.trim();
      const pass = document.getElementById('cloudPassword').value;
      cloudAuth.signInWithEmailAndPassword(email, pass).catch(function(err) {
        document.getElementById('cloudLoginError').innerText = 'Lỗi: ' + err.message;
        document.getElementById('cloudLoginError').style.display = 'block';
      });
    }

    function cloudSignOut() {
      if (cloudAuth) cloudAuth.signOut();
      document.getElementById('licenseLockModal').style.display = 'none';
      closeModal('settingsModal');
    }

    function startCloudSync() {
      if (!cloudFirestore || !cloudUser) return;
      stopCloudSync();

      const uid = cloudUser.uid;

      cloudUnsubBrand = cloudFirestore.collection('users').doc(uid)
        .onSnapshot(function(docSnap) {
          if (docSnap.exists) {
            const remoteData = docSnap.data();
            checkLicenseExpiry(remoteData);
            if (remoteData.title) {
              db.brand = Object.assign({}, db.brand, remoteData);
              saveDBLocalOnly();
              renderHome();
            }
          }
        });

      cloudUnsubCustomers = cloudFirestore.collection('users').doc(uid).collection('customers')
        .onSnapshot(function(snapshot) {
          if (!db.customers) db.customers = [];
          let changed = false;

          snapshot.docChanges().forEach(function(change) {
            const remoteCust = change.doc.data();
            const idx = db.customers.findIndex(c => c.id === remoteCust.id);

            if (change.type === 'removed') {
              if (idx !== -1) { db.customers.splice(idx, 1); changed = true; }
              return;
            }

            const localUpdated = idx !== -1 ? (db.customers[idx].updatedAt || 0) : -1;
            const remoteUpdated = remoteCust.updatedAt || 0;
            if (remoteUpdated >= localUpdated) {
              if (idx !== -1) db.customers[idx] = remoteCust;
              else db.customers.push(remoteCust);
              changed = true;
            }
          });

          if (changed) {
            saveDBLocalOnly();
            renderHome();
            renderCustomerList();
            renderWarrantyList();
          }
        });

      cloudUnsubAppointments = cloudFirestore.collection('users').doc(uid).collection('appointments')
        .onSnapshot(function(snapshot) {
          if (!db.appointments) db.appointments = [];
          let changed = false;

          snapshot.docChanges().forEach(function(change) {
            const remoteAppt = change.doc.data();
            const idx = db.appointments.findIndex(a => a.id === remoteAppt.id);

            if (change.type === 'removed') {
              if (idx !== -1) { db.appointments.splice(idx, 1); changed = true; }
              return;
            }

            const localUpdated = idx !== -1 ? (db.appointments[idx].updatedAt || 0) : -1;
            const remoteUpdated = remoteAppt.updatedAt || 0;
            if (remoteUpdated >= localUpdated) {
              if (idx !== -1) db.appointments[idx] = remoteAppt;
              else db.appointments.push(remoteAppt);
              changed = true;
            }
          });

          if (changed) {
            saveDBLocalOnly();
            renderAppointmentList();
          }
        });
    }

    function stopCloudSync() {
      if (cloudUnsubCustomers) { cloudUnsubCustomers(); cloudUnsubCustomers = null; }
      if (cloudUnsubAppointments) { cloudUnsubAppointments(); cloudUnsubAppointments = null; }
      if (cloudUnsubBrand) { cloudUnsubBrand(); cloudUnsubBrand = null; }
    }

    function syncCustomerToCloud(customerId) {
      if (!cloudFirestore || !cloudUser) return;
      const customer = db.customers.find(c => c.id === customerId);
      if (!customer) return;
      customer.updatedAt = Date.now();
      cloudFirestore.collection('users').doc(cloudUser.uid).collection('customers').doc(customerId).set(customer);
    }

    function cloudDeleteCustomer(customerId) {
      if (!cloudFirestore || !cloudUser) return;
      cloudFirestore.collection('users').doc(cloudUser.uid).collection('customers').doc(customerId).delete();
    }

    function syncAppointmentToCloud(apptId) {
      if (!cloudFirestore || !cloudUser) return;
      const appt = (db.appointments || []).find(a => a.id === apptId);
      if (!appt) return;
      appt.updatedAt = Date.now();
      cloudFirestore.collection('users').doc(cloudUser.uid).collection('appointments').doc(apptId).set(appt);
    }

    function cloudDeleteAppointment(apptId) {
      if (!cloudFirestore || !cloudUser) return;
      cloudFirestore.collection('users').doc(cloudUser.uid).collection('appointments').doc(apptId).delete();
    }

    function syncBrandToCloud() {
      if (!cloudFirestore || !cloudUser) return;
      db.brand.updatedAt = Date.now();
      cloudFirestore.collection('users').doc(cloudUser.uid).set(db.brand, { merge: true });
    }

    /* ============================================================================
       CÁC HÀM TIỆN ÍCH, DỊCH VỤ, LỊCH HẸN & BẢO HÀNH
       ============================================================================ */
    const serviceCategories = {
      'moi': { name: 'Môi', title: 'Chọn loại dịch vụ Môi:', items: ['Phun môi', 'Khử thâm', 'Phụ thu'] },
      'may': { name: 'Mày', title: 'Chọn loại dịch vụ Mày:', items: ['Phun Ombre', 'Sợi đầu phun đuôi', 'Điêu khắc sợi', 'Phụ thu'] },
      'mi': { name: 'Mí mắt', title: 'Chọn loại dịch vụ Mí mắt:', items: ['Mí trên', 'Mí dưới', 'Phụ thu'] },
      'combo': { name: 'Combo', title: 'Chọn loại dịch vụ Combo:', items: ['Mày và môi', 'Mày và mí', 'Mí và môi', 'Phụ thu'] },
      'nhuhoa': { name: 'Nhũ hoa', title: 'Chọn dịch vụ Nhũ hoa:', items: ['Làm hồng nhũ', 'Phụ thu'] },
      'xoa': { name: 'Xóa', title: 'Chọn loại dịch vụ Xóa:', items: ['Xóa mày', 'Xóa hình xăm', 'Xóa môi', 'Xóa mí', 'Phụ thu'] }
    };

    function formatMoney(amount) {
      return new Intl.NumberFormat('vi-VN').format(amount || 0) + ' đ';
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
    }

    function escapeHtmlMultiline(str) {
      return escapeHtml(str).replace(/\n/g, '<br>');
    }

    function escapeJsAttr(str) {
      if (!str) return '';
      return String(str).replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '&quot;');
    }

    function getTodayDateTimeString() {
      const now = new Date();
      const y = now.getFullYear();
      const m = String(now.getMonth() + 1).padStart(2, '0');
      const d = String(now.getDate()).padStart(2, '0');
      const h = String(now.getHours()).padStart(2, '0');
      const mi = String(now.getMinutes()).padStart(2, '0');
      return `${y}-${m}-${d}T${h}:${mi}`;
    }

    function formatDateTimeDisplay(dtStr) {
      if (!dtStr) return '---';
      const d = new Date(dtStr);
      if (isNaN(d.getTime())) return dtStr;
      return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')} - ${String(d.getDate()).padStart(2, '0')}/${String(d.getMonth() + 1).padStart(2, '0')}/${d.getFullYear()}`;
    }

    function formatCurrencyInput(input) {
      let value = input.value.replace(/\D/g, '');
      input.value = value ? new Intl.NumberFormat('vi-VN').format(value) : '';
    }

    function handlePriceOrPaidChange() {
      const priceInput = document.getElementById('custPrice');
      const paidInput = document.getElementById('custPaid');
      const debtInput = document.getElementById('custDebt');

      formatCurrencyInput(priceInput);
      formatCurrencyInput(paidInput);

      const price = parseInt(priceInput.value.replace(/\D/g, '')) || 0;
      const paid = parseInt(paidInput.value.replace(/\D/g, '')) || 0;
      debtInput.value = formatMoney(Math.max(0, price - paid));
    }

    function setFullPayment() {
      document.getElementById('custPaid').value = document.getElementById('custPrice').value;
      handlePriceOrPaidChange();
    }

    function setZeroPayment() {
      document.getElementById('custPaid').value = '0';
      handlePriceOrPaidChange();
    }

    function calculateWarranty(dateStr, months) {
      const m = parseInt(months);
      if (isNaN(m) || m <= 0) {
        return { expiryDateStr: 'Không bảo hành', daysLeft: 0, isOverdue: false, overdueDays: 0, isNoWarranty: true };
      }
      let expiryDate = new Date(dateStr);
      expiryDate.setMonth(expiryDate.getMonth() + m);
      let diffDays = Math.ceil((expiryDate - new Date()) / (1000 * 60 * 60 * 24));
      return {
        expiryDateStr: `${String(expiryDate.getDate()).padStart(2, '0')}/${String(expiryDate.getMonth() + 1).padStart(2, '0')}/${expiryDate.getFullYear()}`,
        daysLeft: diffDays,
        isOverdue: diffDays < 0,
        overdueDays: Math.abs(diffDays),
        isNoWarranty: false
      };
    }

    function renderHome() {
      document.getElementById('brandTitle').innerText = db.brand.title;
      document.getElementById('brandSlogan').innerText = db.brand.slogan;
      document.getElementById('heroBrandName').innerText = db.brand.title;
      document.getElementById('brandLogo').src = db.brand.logo || defaultBrandLogo;

      const recentContainer = document.getElementById('homeRecentList');
      if (!db.customers || db.customers.length === 0) {
        recentContainer.innerHTML = `<div style="color: var(--text-muted); font-size: 13px; text-align: center; padding: 20px;">Chưa có dữ liệu khách hàng. Bấm "+" để thêm mới.</div>`;
        return;
      }

      let recent = [...db.customers].reverse().slice(0, 3);
      recentContainer.innerHTML = recent.map(c => {
        let lastSession = c.sessions[c.sessions.length - 1];
        let paid = (lastSession.paid !== undefined) ? lastSession.paid : lastSession.price;
        let debt = Math.max(0, (lastSession.price || 0) - paid);
        let debtBadge = debt > 0 ? `<span style="color: var(--danger); font-size: 11px; font-weight: bold; margin-left: 6px;">(Nợ: ${formatMoney(debt)})</span>` : '';
        return `
          <div class="card customer-item" onclick="openCustomerDetail('${c.id}')">
            <div>
              <div style="font-weight: 700; font-size: 14px;">${escapeHtml(c.name)} <span style="font-size: 12px; color: var(--text-muted);">(${escapeHtml(c.phone)})</span></div>
              <div style="font-size: 12px; color: var(--primary-gold); margin-top: 3px;">Dịch vụ: ${escapeHtml(lastSession.service)} - ${formatMoney(lastSession.price)} ${debtBadge}</div>
            </div>
            <i class="fa-solid fa-chevron-right" style="color: var(--text-muted); font-size: 12px;"></i>
          </div>
        `;
      }).join('');
    }

    function renderCustomerList() {
      const q = (document.getElementById('customerSearchInput').value || '').toLowerCase().trim();
      const container = document.getElementById('customerList');
      if (!db.customers) db.customers = [];

      let filtered = db.customers.filter(c => (c.name && c.name.toLowerCase().includes(q)) || (c.phone && c.phone.includes(q)));
      if (filtered.length === 0) {
        container.innerHTML = `<div style="text-align: center; color: var(--text-muted); padding: 25px;">Không tìm thấy khách hàng nào.</div>`;
        return;
      }

      container.innerHTML = filtered.map(c => {
        let serviceList = c.sessions ? c.sessions.map(s => s.service).join(', ') : '';
        let totalDebt = 0;
        if (c.sessions) {
          c.sessions.forEach(s => {
            let p = s.price || 0;
            let pd = (s.paid !== undefined) ? s.paid : p;
            totalDebt += Math.max(0, p - pd);
          });
        }
        let debtTag = totalDebt > 0 ? `<span class="badge badge-danger" style="margin-top: 4px;">Nợ: ${formatMoney(totalDebt)}</span>` : '';

        return `
          <div class="card customer-item" onclick="openCustomerDetail('${c.id}')">
            <div style="flex: 1;">
              <div style="font-weight: bold; font-size: 15px;">${escapeHtml(c.name)} ${debtTag}</div>
              <div style="font-size: 12px; color: var(--text-muted); margin: 3px 0;">SĐT: ${escapeHtml(c.phone)} | ĐC: ${escapeHtml(c.address) || 'Chưa lưu'}</div>
              <div style="font-size: 12px; margin-top: 4px;">Đã làm: <strong style="color: var(--primary-gold);">${escapeHtml(serviceList)}</strong></div>
            </div>
            <div style="display: flex; gap: 6px;" onclick="event.stopPropagation();">
              <a class="btn-call" href="tel:${escapeHtml(c.phone)}" title="Gọi"><i class="fa-solid fa-phone"></i></a>
              <button class="btn-remind" onclick="openQuickMessageModal('${c.id}')" title="Nhắn"><i class="fa-solid fa-comment-dots"></i></button>
            </div>
          </div>
        `;
      }).join('');
    }

    function renderWarrantyList() {
      const q = (document.getElementById('warrantySearchInput').value || '').toLowerCase().trim();
      const container = document.getElementById('warrantyList');
      if (!db.customers || db.customers.length === 0) {
        container.innerHTML = `<div style="color: var(--text-muted); text-align: center; padding: 25px;">Chưa có dữ liệu bảo hành.</div>`;
        return;
      }

      let groups = [];
      db.customers.forEach(c => {
        if (c.sessions && c.sessions.length > 0) {
          let sList = c.sessions.map(s => {
            let w = calculateWarranty(s.date, s.warrantyMonths);
            return { ...s, ...w };
          });
          groups.push({ customer: c, sessions: sList });
        }
      });

      container.innerHTML = groups.map(g => `
        <div class="card" style="border-left: 4px solid var(--primary-gold); margin-bottom: 12px;">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <div style="font-weight: bold; font-size: 15px; color: var(--primary-gold);">${escapeHtml(g.customer.name)} (${escapeHtml(g.customer.phone)})</div>
          </div>
          ${g.sessions.map(item => `
            <div class="warranty-sub-item ${item.warrantyDone ? 'completed' : (item.isOverdue ? 'overdue' : '')}">
              <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
                <strong>${escapeHtml(item.service)}</strong>
                <span class="badge ${item.isOverdue ? 'badge-danger' : 'badge-warning'}">${item.expiryDateStr}</span>
              </div>
              <div class="warranty-actions-row">
                <a class="btn-call" href="tel:${escapeHtml(g.customer.phone)}"><i class="fa-solid fa-phone"></i></a>
                <button class="btn-remind" onclick="openRemindModal('${g.customer.id}', '${item.id}')"><i class="fa-solid fa-comment-dots"></i> Nhắc Zalo</button>
              </div>
            </div>
          `).join('')}
        </div>
      `).join('');
    }

    function renderAppointmentList() {
      const container = document.getElementById('appointmentList');
      if (!db.appointments || db.appointments.length === 0) {
        container.innerHTML = `<div style="text-align: center; color: var(--text-muted); padding: 25px;">Không có lịch hẹn nào.</div>`;
        return;
      }

      container.innerHTML = db.appointments.map(a => `
        <div class="card">
          <div style="display: flex; justify-content: space-between; font-weight: bold;">
            <span>${escapeHtml(a.name)}</span>
            <span class="badge badge-warning">${formatDateTimeDisplay(a.dateTime)}</span>
          </div>
          <div style="font-size: 12px; color: var(--text-muted); margin: 4px 0;">SĐT: ${escapeHtml(a.phone)} &bull; DV: ${escapeHtml(a.service)}</div>
          <div style="display: flex; gap: 6px; margin-top: 8px;">
            <a class="btn-call" href="tel:${escapeHtml(a.phone)}"><i class="fa-solid fa-phone"></i> Gọi</a>
            <button class="btn-outline" style="border-color: var(--danger); color: var(--danger);" onclick="deleteAppointment('${a.id}')"><i class="fa-solid fa-trash"></i> Xóa</button>
          </div>
        </div>
      `).join('');
    }

    let currentImgBefore = "";
    let currentImgAfter = "";

    function triggerPhotoSelect(type) {
      document.getElementById(type === 'before' ? 'imgBeforeInput' : 'imgAfterInput').click();
    }

    function compressImageFile(file, maxDimension, quality, onDone) {
      const reader = new FileReader();
      reader.onload = function(e) {
        const img = new Image();
        img.onload = function() {
          let w = img.width, h = img.height;
          if (w > h && w > maxDimension) { h = Math.round((h * maxDimension) / w); w = maxDimension; }
          else if (h > maxDimension) { w = Math.round((w * maxDimension) / h); h = maxDimension; }
          const canvas = document.createElement('canvas');
          canvas.width = w; canvas.height = h;
          canvas.getContext('2d').drawImage(img, 0, 0, w, h);
          onDone(canvas.toDataURL('image/jpeg', quality));
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    }

    function handleImageUpload(event, imgId, textId, type) {
      const file = event.target.files[0];
      if (!file) return;
      compressImageFile(file, 600, 0.7, function(dataUrl) {
        document.getElementById(imgId).src = dataUrl;
        document.getElementById(imgId).style.display = 'block';
        document.getElementById(textId).style.display = 'none';
        if (type === 'before') { currentImgBefore = dataUrl; document.getElementById('btnDelBefore').style.display = 'flex'; }
        else { currentImgAfter = dataUrl; document.getElementById('btnDelAfter').style.display = 'flex'; }
      });
    }

    function removePhoto(type) {
      if (type === 'before') {
        currentImgBefore = "";
        document.getElementById('previewBefore').style.display = 'none';
        document.getElementById('textBefore').style.display = 'flex';
        document.getElementById('btnDelBefore').style.display = 'none';
      } else {
        currentImgAfter = "";
        document.getElementById('previewAfter').style.display = 'none';
        document.getElementById('textAfter').style.display = 'flex';
        document.getElementById('btnDelAfter').style.display = 'none';
      }
    }

    function toggleServiceGroup(groupKey, preselectedSub = null) {
      document.querySelectorAll('#customerModal .service-parent-btn').forEach(btn => btn.classList.remove('active'));
      const activeBtn = document.getElementById('btn-grp-' + groupKey);
      if (activeBtn) activeBtn.classList.add('active');

      const grp = serviceCategories[groupKey];
      document.getElementById('subServiceTitle').innerText = grp.title;
      let targetSub = preselectedSub || grp.items[0];

      document.getElementById('subServiceGrid').innerHTML = grp.items.map(item => `
        <div class="sub-chip ${item === targetSub ? 'selected' : ''}" onclick="selectSubService('${item}')">${item}</div>
      `).join('');

      selectSubService(targetSub);
    }

    function selectSubService(subItemName) {
      document.querySelectorAll('#customerModal .sub-chip').forEach(c => {
        c.classList.toggle('selected', c.innerText.trim() === subItemName);
      });
      document.getElementById('custService').value = subItemName;
      document.getElementById('displaySelectedService').innerText = subItemName;
    }

    function selectWarranty(el, val) {
      document.querySelectorAll('.warranty-options .chip').forEach(c => c.classList.remove('selected'));
      el.classList.add('selected');
      document.getElementById('custWarrantyMonths').value = val;
    }

    function openAddCustomerModal() {
      document.getElementById('custEditId').value = '';
      document.getElementById('custSessionEditId').value = '';
      removePhoto('before');
      removePhoto('after');
      document.getElementById('custName').value = '';
      document.getElementById('custPhone').value = '';
      document.getElementById('custAddress').value = '';
      document.getElementById('custPrice').value = '';
      document.getElementById('custPaid').value = '';
      document.getElementById('custDebt').value = '0 đ';
      document.getElementById('custDate').value = getTodayDateTimeString();
      toggleServiceGroup('moi');
      document.getElementById('customerModal').style.display = 'block';
    }

    async function saveCustomerData(openQRAfter = false) {
      const name = document.getElementById('custName').value.trim();
      const phone = document.getElementById('custPhone').value.trim();
      if (!name || !phone) {
        showAppAlert('Vui lòng nhập Tên và Số điện thoại!');
        return;
      }

      let price = parseInt(document.getElementById('custPrice').value.replace(/\D/g, '')) || 0;
      let paid = parseInt(document.getElementById('custPaid').value.replace(/\D/g, '')) || 0;

      const sessionData = {
        id: 's_' + Date.now(),
        service: document.getElementById('custService').value,
        preStatus: document.getElementById('custPreStatus').value.trim(),
        process: document.getElementById('custProcess').value.trim(),
        colorMix: document.getElementById('custColorMix').value.trim(),
        date: document.getElementById('custDate').value || getTodayDateTimeString(),
        price: price,
        paid: isNaN(paid) ? price : paid,
        warrantyMonths: parseInt(document.getElementById('custWarrantyMonths').value) || 1,
        imgBefore: currentImgBefore,
        imgAfter: currentImgAfter
      };

      const newCustomer = {
        id: 'c_' + Date.now(),
        name, phone,
        address: document.getElementById('custAddress').value.trim(),
        sessions: [sessionData]
      };

      db.customers.push(newCustomer);
      markDataChanged();
      await saveDB();
      syncCustomerToCloud(newCustomer.id);

      closeModal('customerModal');
      renderHome();
      renderCustomerList();
      renderWarrantyList();
      showAppAlert('Lưu hồ sơ thành công!');
    }

    function openCustomerDetail(custId) {
      const c = db.customers.find(item => item.id === custId);
      if (!c) return;

      let html = `
        <div style="background: var(--bg-input); padding: 14px; border-radius: 10px; margin-bottom: 14px;">
          <h2 style="color: var(--primary-gold); font-size: 18px;">${escapeHtml(c.name)}</h2>
          <div style="font-size: 13px; color: var(--text-muted); margin-top: 4px;">SĐT: ${escapeHtml(c.phone)} | ĐC: ${escapeHtml(c.address)}</div>
        </div>
        ${c.sessions.map((s, idx) => `
          <div class="card" style="background: var(--bg-input); border-left: 4px solid var(--primary-gold); margin-bottom: 10px; font-size: 13px;">
            <div style="display: flex; justify-content: space-between; font-weight: bold; margin-bottom: 6px;">
              <span>Lần ${idx + 1}:${escapeHtml(s.service)}</span>
              <span style="color: var(--primary-gold);">${formatMoney(s.price)}</span>
            </div>
            <div>Màu đã pha: <strong>${escapeHtml(s.colorMix) || 'Mặc định'}</strong></div>
            <div>Thời gian: ${formatDateTimeDisplay(s.date)}</div>
          </div>
        `).join('')}
      `;
      document.getElementById('customerDetailContent').innerHTML = html;
      document.getElementById('customerDetailModal').style.display = 'block';
    }

    let currentRemindPhone = "";
    function openRemindModal(custId, sessionId) {
      const c = db.customers.find(item => item.id === custId);
      if (!c) return;
      const s = c.sessions.find(item => item.id === sessionId);
      if (!s) return;

      const w = calculateWarranty(s.date, s.warrantyMonths);
      const msg = db.brand.msgTemplate
        .replace(/{TEN_KH}/g, c.name)
        .replace(/{DICH_VU}/g, s.service)
        .replace(/{HAN_BH}/g, w.expiryDateStr)
        .replace(/{TEN_TIEM}/g, db.brand.title);

      currentRemindPhone = c.phone.replace(/\D/g, '');
      document.getElementById('remindCustName').innerText = c.name;
      document.getElementById('remindCustPhone').innerText = c.phone;
      document.getElementById('remindMessageBody').value = msg;
      document.getElementById('remindModal').style.display = 'block';
    }

    function sendViaZalo() {
      const text = document.getElementById('remindMessageBody').value;
      navigator.clipboard.writeText(text).then(() => {
        window.open(`https://zalo.me/${currentRemindPhone}`, '_blank');
      });
    }

    function sendViaSMS() {
      const text = encodeURIComponent(document.getElementById('remindMessageBody').value);
      window.location.href = `sms:${currentRemindPhone}?body=${text}`;
    }

    function copyReminderText() {
      navigator.clipboard.writeText(document.getElementById('remindMessageBody').value);
      showAppAlert('Đã sao chép tin nhắn!');
    }

    function openAppointmentModal() {
      document.getElementById('apptName').value = '';
      document.getElementById('apptPhone').value = '';
      document.getElementById('apptNote').value = '';
      document.getElementById('apptDateTime').value = getTodayDateTimeString();
      document.getElementById('appointmentModal').style.display = 'block';
    }

    async function saveAppointmentData() {
      const name = document.getElementById('apptName').value.trim();
      const phone = document.getElementById('apptPhone').value.trim();
      const dateTime = document.getElementById('apptDateTime').value;
      if (!name || !phone || !dateTime) {
        showAppAlert('Vui lòng nhập đủ thông tin!');
        return;
      }
      const appt = { id: 'a_' + Date.now(), name, phone, dateTime, service: 'Phun xăm', note: document.getElementById('apptNote').value };
      db.appointments.push(appt);
      markDataChanged();
      await saveDB();
      syncAppointmentToCloud(appt.id);
      closeModal('appointmentModal');
      renderAppointmentList();
      showAppAlert('Lưu lịch hẹn thành công!');
    }

    async function deleteAppointment(id) {
      if (confirm('Xóa lịch hẹn này?')) {
        db.appointments = db.appointments.filter(a => a.id !== id);
        markDataChanged();
        await saveDB();
        cloudDeleteAppointment(id);
        renderAppointmentList();
      }
    }

    function unlockRevenue() {
      if (document.getElementById('passcodeInput').value === db.brand.passcode) {
        document.getElementById('revenueLockScreen').style.display = 'none';
        document.getElementById('revenueContent').style.display = 'block';
        renderRevenue();
      } else {
        showAppAlert('Sai mật khẩu!');
      }
    }

    function lockRevenue() {
      document.getElementById('revenueLockScreen').style.display = 'block';
      document.getElementById('revenueContent').style.display = 'none';
    }

    function renderRevenue() {
      let total = 0;
      (db.customers || []).forEach(c => {
        (c.sessions || []).forEach(s => {
          total += (s.paid !== undefined) ? s.paid : (s.price || 0);
        });
      });
      document.getElementById('revToday').innerText = formatMoney(total);
      document.getElementById('revMonth').innerText = formatMoney(total);
    }

    function switchTab(tabId, el) {
      document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
      document.getElementById('tab-' + tabId).classList.add('active');
      el.classList.add('active');

      if (tabId === 'home') renderHome();
      if (tabId === 'customers') renderCustomerList();
      if (tabId === 'appointments') renderAppointmentList();
      if (tabId === 'warranty') renderWarrantyList();
      if (tabId === 'revenue') renderRevenue();
    }

    function openSettingsModal() {
      document.getElementById('settingTitle').value = db.brand.title;
      document.getElementById('settingSlogan').value = db.brand.slogan;
      document.getElementById('settingMsgTemplate').value = db.brand.msgTemplate;
      document.getElementById('settingsModal').style.display = 'block';
      renderCloudSettingsBox();
    }

    function switchSettingsTab(tabName, el) {
      document.querySelectorAll('.settings-tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.settings-tab-content').forEach(c => c.classList.remove('active'));
      el.classList.add('active');
      document.getElementById('settingsTab-' + tabName).classList.add('active');
    }

    async function saveBrandSettings() {
      db.brand.title = document.getElementById('settingTitle').value || db.brand.title;
      db.brand.slogan = document.getElementById('settingSlogan').value || db.brand.slogan;
      db.brand.msgTemplate = document.getElementById('settingMsgTemplate').value || db.brand.msgTemplate;
      await saveDB();
      syncBrandToCloud();
      renderHome();
      closeModal('settingsModal');
      showAppAlert('Đã lưu cài đặt!');
    }

    async function exportDataFile() {
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(db, null, 2));
      const a = document.createElement('a');
      a.href = dataStr;
      a.download = `SaoLuu_PMU_${Date.now()}.json`;
      a.click();
    }

    function closeModal(id) { document.getElementById(id).style.display = 'none'; }
    function showAppAlert(msg) {
      document.getElementById('customAlertMessage').innerText = msg;
      document.getElementById('customAlertModal').style.display = 'block';
    }
    function closeCustomAlert() { closeModal('customAlertModal'); }

    window.onload = async function() {
      try {
        let saved = await localforage.getItem('na_pmu_db');
        if (saved) db = saved;
      } catch (e) {}
      renderHome();
      initFirebase();
    };
  </script>
</body>
</html>